{
  "meta": {
    "id": "items",
    "label": "Item Database",
    "version": 1,
    "description": "Open-ended item archetypes inspired by ChainLink ItemBase / ItemRecipe: properties, craft steps, and media. Schema stays flexible while authoring.",
    "sources": [
      "ChainLink ItemPropertyDatabase (ItemBase, ItemRecipe, ItemPropertyValue)",
      "For Review/ITEM_PROPERTY_SYSTEM.md",
      "Trailbound.md / Crafting and Item Attributes",
      "Material Tables II"
    ],
    "schemaNotes": [
      "kind: tool | food | material-item | consumable | component (extensible)",
      "properties[]: ItemPropertyValue-like rows (propertyId, valueType, value)",
      "recipe.steps[]: loose RecipeStep sketches (name, laborRequirement, requirements)",
      "addressableAsset: optional Unity addressable / prefab hint",
      "media optional; placeholders used for model + reference carousel testing"
    ]
  },
